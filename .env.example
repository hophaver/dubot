# Required
DISCORD_BOT_TOKEN=

# Ollama (default http://localhost:11434)
OLLAMA_URL=

# Home Assistant (optional; HA commands are disabled until both are set)
HA_URL=
HA_ACCESS_TOKEN=

# /himas: Home Assistant Assist (POST /api/conversation/process) runs first when enabled.
HIMAS_ASSIST_ENABLED=true
# BCP-47 language for Assist (e.g. en, fi)
HIMAS_ASSIST_LANGUAGE=en
# Optional: Assist agent_id from HA (e.g. conversation.home_assistant or your pipeline agent)
HIMAS_ASSIST_AGENT_ID=

# When Assist cannot handle the request, the bot falls back to pattern matching + LLM JSON parse.
# HIMAS_PARSE_PROVIDER: auto (user's chat model, cloud vs local), ollama, local (same as ollama), or openrouter
HIMAS_PARSE_PROVIDER=auto
# Fixed model for fallback parse (Ollama name, or OpenRouter id like openai/gpt-4o-mini)
HIMAS_PARSE_MODEL=

# OpenRouter API key for cloud chat models, image generation and /bal (aliases: OPENROUTER_KEY, OPENROUTER_APIKEY)
OPENROUTER_API_KEY=
# Optional overrides (leave empty to use OPENROUTER_API_KEY):
#   chat/completions + image generation
OPENROUTER_CHAT_API_KEY=
#   /bal credits (management key)
OPENROUTER_MANAGEMENT_API_KEY=

# Cursor user key for /cursor (CURSOR_API_KEY is a legacy alias).
# Note: Cursor's spend endpoint may still require Admin API permissions.
CURSOR_USER_API_KEY=

# Optional: interpreter used by /run for .py scripts (default: the bot's own Python)
PYTHON=

# scripts/site-*.py: SSH host, user, remote dir and script names
SITE_UPDATE_HOST=
SITE_UPDATE_USER=
SITE_UPDATE_DIRECTORY=
SITE_UPDATE_SCRIPT=stop.sh
SITE_UPDATE_SCRIPT_PREVIEW=preview.sh
# Password for SSH (used with sshpass when set; leave empty for key-based auth)
SITE_UPDATE_SSH_PASSWORD=
